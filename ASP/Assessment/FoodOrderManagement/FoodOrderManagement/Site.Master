<%@ Master Language="C#" AutoEventWireup="true"
    CodeBehind="Site.master.cs"
    Inherits="FoodOrderManagement.SiteMaster" %>

<!DOCTYPE html>

<html>
<head runat="server">

    <title>Food Order Management</title>

    <style>

        body
        {
            margin: 0;
            padding: 0;
            font-family: Arial;
            background-color: #f4f4f4;
        }

        .header
        {
            background-color: darkred;
            color: white;
            text-align: center;
            padding: 20px;
        }

        .menu
        {
            background-color: black;
            padding: 15px;
            text-align: center;
        }

        .menu a
        {
            color: white;
            text-decoration: none;
            margin: 20px;
            font-size: 18px;
            font-weight: bold;
        }

        .container
        {
            width: 90%;
            margin: 40px auto;
            background-color: white;
            padding: 30px;
            border-radius: 10px;
            box-shadow: 0px 0px 10px gray;
        }

        .footer
        {
            background-color: darkred;
            color: white;
            text-align: center;
            padding: 15px;
            margin-top: 30px;
        }

        h2
        {
            text-align: center;
            color: blue;
        }

        table
        {
            margin: auto;
        }

    </style>

</head>

<body>

    <form runat="server">

        <div class="header">

            <h1>Online Food Ordering Management System</h1>

        </div>

        <div class="menu">

            <a runat="server" href="~/MenuList.aspx">
                Menu Items
            </a>

            <a runat="server" href="~/AddEditMenu.aspx">
                Add Menu
            </a>

            <a runat="server" href="~/OrderStats.aspx">
                Order Stats
            </a>

            <a runat="server" href="~/Logout.aspx">
                Logout
            </a>

        </div>

        <div class="container">

            <asp:ContentPlaceHolder
                ID="MainContent"
                runat="server">
            </asp:ContentPlaceHolder>

        </div>

        <div class="footer">

            © 2026 Food Order Management

        </div>

    </form>

</body>
</html>