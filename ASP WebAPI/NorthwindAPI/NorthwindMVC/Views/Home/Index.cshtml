@model IEnumerable<NorthwindMVC.Models.Order>

<h2>Orders List</h2>

<table border="1">

    <tr>
        <th>Order ID</th>
        <th>Employee ID</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.OrderID</td>
            <td>@item.EmployeeID</td>
        </tr>
    }

</table>