<!DOCTYPE html>
<html>
<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@ViewBag.Title</title>

    @Styles.Render("~/Content/css")

    <style>

        body {
            background-color: #f4f6f9;
            font-family: 'Segoe UI';
        }

        .navbar {
            background-color: #212529;
            padding: 15px;
        }

        .navbar-brand {
            color: white !important;
            font-size: 26px;
            font-weight: bold;
        }

        .nav-link {
            color: white !important;
            margin-right: 15px;
        }

        .content-box {
            background-color: white;
            margin-top: 30px;
            padding: 30px;
            border-radius: 12px;
            box-shadow: 0px 0px 10px lightgray;
        }

        footer {
            margin-top: 50px;
            background-color: #212529;
            color: white;
            text-align: center;
            padding: 15px;
        }
    </style>

</head>

<body>

    <nav class="navbar navbar-expand-lg">

        <div class="container-fluid">

            <a class="navbar-brand"
               href="/Movies/Index">

                Movies MVC

            </a>

            <div>

                <a class="nav-link d-inline"
                   href="/Movies/Index">

                    Home

                </a>

                <a class="nav-link d-inline"
                   href="/Movies/Create">

                    Add Movie

                </a>

                <a class="nav-link d-inline"
                   href="/Movies/MoviesByYear">

                    Search By Year

                </a>

                <a class="nav-link d-inline"
                   href="/Movies/MoviesByDirector">

                    Search By Director

                </a>

            </div>

        </div>

    </nav>

    <div class="container">

        <div class="content-box">

            @RenderBody()

        </div>

    </div>

    <footer>

        ASP.NET MVC Movie Management System

    </footer>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")

</body>
</html>