@model MoviesMVC.Models.Movie

<h2>Add Movie</h2>

@using (Html.BeginForm())
{
    <p>Movie Name</p>
    @Html.TextBoxFor(m => m.MovieName)

    <p>Director Name</p>
    @Html.TextBoxFor(m => m.DirectorName)

    <p>Date Of Release</p>
    @Html.TextBoxFor(m => m.DateOfRelease)

    <br />
    <br />

    <input type="submit" value="Save" />
}

